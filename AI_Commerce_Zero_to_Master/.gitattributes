# Keep Linux/container files LF even when cloned on Windows with core.autocrlf=true.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Keep Windows launchers/scripts in native CRLF form.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source files are text; let Git normalize them consistently.
*.py text eol=lf
*.java text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
