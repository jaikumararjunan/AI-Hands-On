{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentIntentCreated",
  "type": "object",
  "required": ["eventId", "paymentId", "orderId", "amount", "currency", "status", "occurredAt"],
  "properties": {
    "eventId": {"type": "string"},
    "paymentId": {"type": "string"},
    "orderId": {"type": "string"},
    "amount": {"type": "number"},
    "currency": {"type": "string"},
    "status": {"type": "string"},
    "occurredAt": {"type": "string", "format": "date-time"}
  }
}
